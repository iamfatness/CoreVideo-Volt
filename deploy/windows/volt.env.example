# @DATA_DIR@\volt.env : settings for `volt run --env-file`. KEY=VALUE, no quotes needed, backslashes are literal.
# Variables already set in the service environment win over this file. The installer restricts this file to
# SYSTEM and Administrators: it holds the operator token and possibly a database password.
# Every variable is described in docs/operations.md.

# Database: a SQLite file (default shown) or postgres://user:password@host:5432/dbname
VOLT_DB=@DATA_DIR@\volt.db

# Directories
VOLT_OUT=@DATA_DIR@\out
VOLT_PROXY_DIR=@DATA_DIR@\proxy
VOLT_PUBLISH_DIR=@DATA_DIR@\publish
VOLT_LOG_DIR=@DATA_DIR@\logs

# Network. Beyond loopback a token of 16+ characters is required, and TLS should come from a reverse proxy.
VOLT_HOST=127.0.0.1
VOLT_PORT=8765
# VOLT_TOKEN=change-me-to-a-long-random-string

# The CoreVideo Pro core the clock and cues talk to. Without VOLT_ROOM_URL the clock is not started.
# VOLT_ROOM_URL=http://127.0.0.1:8011
# VOLT_ROOM_TOKEN=

# Disk floor in MB: new ingest, proxy and thumbnail work is refused under it.
VOLT_MIN_FREE_MB=2048
