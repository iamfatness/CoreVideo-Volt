{
  "title": "Volt",
  "uid": "volt-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "UNVALIDATED: written against the metrics the code emits and checked by a test for that, but never loaded into Grafana. Import it, point DS_PROMETHEUS at your Prometheus, and fix what you find.",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "templating": {
    "list": []
  },
  "tags": [
    "volt"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Availability (volt_up, 1 = database readable)",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min(volt_up)",
          "legendFormat": "up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests in flight",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(volt_http_inflight)",
          "legendFormat": "in flight",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request rate by route class",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (route_class) (rate(volt_http_requests_total[5m]))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Request latency p50",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, route_class) (rate(volt_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request latency p95",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route_class) (rate(volt_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Request latency p99",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route_class) (rate(volt_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Errors (5xx) per second by route class",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (route_class) (rate(volt_http_requests_total{status_class=\"5xx\"}[5m]))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Client errors (4xx) per second by route class",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (route_class) (rate(volt_http_requests_total{status_class=\"4xx\"}[5m]))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Take: time in the room vs our overhead (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(volt_take_seconds_bucket[5m])))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Database connect time p95",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(volt_db_checkout_seconds_bucket[5m])))",
          "legendFormat": "connect",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Postgres pool: in use and waiting",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(volt_db_pool_in_use)",
          "legendFormat": "in use",
          "refId": "A"
        },
        {
          "expr": "sum(volt_db_pool_waiting)",
          "legendFormat": "waiting",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "Queued jobs by type",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (type) (volt_jobs{state=\"queued\"})",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Oldest queued job (seconds)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(volt_queue_oldest_queued_age_seconds)",
          "legendFormat": "oldest",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Job run time p95 by type",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(volt_job_seconds_bucket[5m])))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Job queue wait p95 by type",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(volt_job_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "Runner claims by outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(volt_runner_claims_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "title": "Runners alive",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(volt_runners_alive)",
          "legendFormat": "runners",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "title": "Stuck jobs",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(volt_jobs_stuck)",
          "legendFormat": "stuck",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "title": "Disk free (bytes)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min by (dir) (volt_disk_free_bytes)",
          "legendFormat": "{{dir}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Newest backup age (seconds)",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(volt_backup_last_age_seconds)",
          "legendFormat": "backup",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "Last passing restore drill age (seconds)",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(volt_restore_drill_last_age_seconds)",
          "legendFormat": "drill",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Refused requests per second by kind (429)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(volt_rate_limited_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Requests refused because the node was full (503 busy)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(volt_busy_total[5m]))",
          "legendFormat": "busy",
          "refId": "A"
        }
      ]
    }
  ]
}
